{
  "name": "breckline",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio web de Breckline - Servicios de desarrollo web y marketing digital",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "preview": "npm run build && npm run start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "optimize:assets": "node ./scripts/optimize-assets.mjs"
  },
  "keywords": [
    "portafolio",
    "desarrollo-web",
    "marketing-digital"
  ],
  "author": "Breckline",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@supabase/supabase-js": "2.112.4",
    "gsap": "^3.13.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  }
}
